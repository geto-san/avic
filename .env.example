# AVIC reads its configuration from real environment variables (PHP does not load
# this file by itself). Copy it, fill it in, and export it however you run PHP:
#   - shell / php -S:   set -a; . ./.env; set +a; php -S 127.0.0.1:8080
#   - Apache:           SetEnv AVIC_DB_PASS ...   (or via your hosting panel)
#   - php-fpm:          env[AVIC_DB_PASS] = ...   in the pool config
#   - systemd/Docker:   Environment= / --env-file
# Never commit a filled-in copy.

# --- database ---
AVIC_DB_HOST=localhost
#AVIC_DB_PORT=3306
AVIC_DB_NAME=avic_portal
AVIC_DB_USER=avic
AVIC_DB_PASS=change-me

# "production" refuses the built-in dev password, refuses to seed demo data,
# and (with HTTPS) keeps session cookies Secure. Leave unset for local dev.
#AVIC_ENV=production

# --- uploads: an absolute path the web server user can write, NOT under the docroot ---
#AVIC_UPLOAD_DIR=/var/lib/avic/uploads

# --- schema ---
# The baseline migration uses MariaDB's utf8mb4_uca1400_ai_ci (MariaDB 11.3+).
# On MySQL or an older MariaDB, swap it for one your server has:
#AVIC_DB_COLLATION=utf8mb4_unicode_ci

# --- demo data (never in production) ---
#AVIC_DEMO_SECRET=pick-your-own-demo-password
