{
    "name": "geto-san/avic",
    "description": "AVIC — a simplified claims-management system modelled on Guidewire ClaimCenter (motor insurance, Uganda).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "scripts": {
        "migrate": "@php bin/migrate.php",
        "seed": "@php bin/seed.php",
        "serve": "@php -S 127.0.0.1:8080 -t public public/index.php",
        "lint": "@php bin/lint.php",
        "test": "@php bin/test.php"
    }
}
