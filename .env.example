# AVIC reads real environment variables; a .env file in the project root is also
# loaded for convenience (it never overrides variables that are already set).
# Never commit a filled-in copy.

AVIC_DB_HOST=127.0.0.1
#AVIC_DB_PORT=3306
AVIC_DB_NAME=avic_portal
AVIC_DB_USER=avic
AVIC_DB_PASS=change-me

# "production" refuses an empty DB password, refuses to seed demo data and
# hides error details. Leave unset for local development.
#AVIC_ENV=production

# Where uploaded documents live. Must NOT be under public/. Default: storage/uploads
#AVIC_UPLOAD_DIR=/var/lib/avic/uploads

# Demo password used by bin/seed.php (never in production)
#AVIC_DEMO_SECRET=Demo2026!
