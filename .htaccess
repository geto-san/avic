Options -Indexes
# Public entry points only. Support PHP files, credentials and tests stay private.
RewriteEngine On
RewriteRule ^$ index.html [L]
RewriteRule ^(?:index\.html|robots\.txt)$ - [L]
RewriteRule ^assets/(?:css/[a-z-]+\.css|js/[a-z-]+\.js|favicon\.svg)$ - [L]
RewriteRule ^pages/(?:auth|claimant|adjuster|garage|errors)/[a-z0-9-]+\.html$ - [L]
RewriteRule ^config/auth/(?:login|logout|register|forgot-password|reset-password|session-token)\.php$ - [L]
RewriteRule ^config/api/(?:bootstrap|claims|claims-assign|claims-decision|claims-status|claims-pdf|documents|estimates|estimates-decision|notifications|payouts-update|policies|health|settlements|complaints|document-responses|policy-registrations)\.php$ - [L]
RewriteRule ^config/uploads\.php$ - [L]
RewriteRule ^ - [R=404,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>
